{
  "expo": {
    "name": "Avatar Cloning",
    "slug": "avatar-cloning",
    "version": "1.0.0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTabletMode": true,
      "usesNonExemptEncryption": false,
      "infoPlist": {
        "NSCameraUsageDescription": "We need access to your camera to capture your face for avatar cloning.",
        "NSMicrophoneUsageDescription": "We need access to your microphone to record your voice for cloning."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.avatarcloning",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Avatar Cloning to access your camera."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow Avatar Cloning to access your microphone."
        }
      ]
    ]
  }
}
